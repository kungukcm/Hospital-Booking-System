# Hospital Booking System - Environment Variables Example
# 
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control!

# Required: Groq API Key (for LLM)
# Get it from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key (alternative LLM)
# Get it from: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Application environment
# Options: development, production
ENVIRONMENT=development

# Optional: SMTP settings for appointment confirmation emails.
# If not set, confirmation emails are skipped (booking still succeeds) and
# the skip is recorded in the admin dashboard's Email Notifications tab.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_USE_TLS=true

